{
  "info": {
    "name": "PMS API v1 — Locations",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000" },
    { "key": "token", "value": "" },
    { "key": "countryId", "value": "1" },
    { "key": "cityId", "value": "1" }
  ],
  "item": [
    {
      "name": "GET locations",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/locations?per_page=15"
      }
    },
    {
      "name": "GET countries/{id}",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/countries/{{countryId}}"
      }
    },
    {
      "name": "POST countries",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name_ar\": \"سوريا\",\n  \"name_en\": \"Syria\",\n  \"iso_code\": \"SY\",\n  \"flag_emoji\": \"🇸🇾\",\n  \"status\": \"active\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/countries"
      }
    },
    {
      "name": "PUT countries/{id}",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name_ar\": \"سوريا\",\n  \"name_en\": \"Syria\",\n  \"iso_code\": \"SY\",\n  \"flag_emoji\": \"🇸🇾\",\n  \"status\": \"active\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/countries/{{countryId}}"
      }
    },
    {
      "name": "PATCH countries/{id}",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name_ar\": \"سوريا\",\n  \"name_en\": \"Syria\",\n  \"iso_code\": \"SY\",\n  \"flag_emoji\": \"🇸🇾\",\n  \"status\": \"inactive\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/countries/{{countryId}}"
      }
    },
    {
      "name": "DELETE countries/{id}",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/countries/{{countryId}}"
      }
    },
    {
      "name": "GET cities",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/cities?per_page=15&country_id={{countryId}}"
      }
    },
    {
      "name": "GET cities/{id}",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/cities/{{cityId}}"
      }
    },
    {
      "name": "POST cities",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"country_id\": 1,\n  \"name_ar\": \"دمشق\",\n  \"name_en\": \"Damascus\",\n  \"status\": \"active\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/cities"
      }
    },
    {
      "name": "PUT cities/{id}",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"country_id\": 1,\n  \"name_ar\": \"دمشق\",\n  \"name_en\": \"Damascus\",\n  \"status\": \"active\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/cities/{{cityId}}"
      }
    },
    {
      "name": "PATCH cities/{id}",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"country_id\": 1,\n  \"name_ar\": \"دمشق\",\n  \"name_en\": \"Damascus\",\n  \"status\": \"inactive\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/cities/{{cityId}}"
      }
    },
    {
      "name": "DELETE cities/{id}",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/cities/{{cityId}}"
      }
    }
  ]
}
