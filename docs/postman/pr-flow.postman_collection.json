{
  "info": {
    "name": "PMS API v1 — PR flow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "GET my-procurement-requests/flow",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/my-procurement-requests/flow?per_page=15"
      }
    },
    {
      "name": "Helpers",
      "item": [
        {
          "name": "flow",
          "item": [
            {
              "name": "per page",
              "request": {
                "method": "GET",
                "header": [{ "key": "Accept", "value": "application/json" }],
                "url": "{{baseUrl}}/api/v1/my-procurement-requests/flow?per_page=15"
              }
            }
          ]
        }
      ]
    }
  ]
}
