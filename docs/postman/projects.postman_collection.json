{
  "info": {
    "name": "PMS API v1 — Projects",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000" },
    { "key": "token", "value": "" },
    { "key": "projectId", "value": "1" }
  ],
  "item": [
    {
      "name": "GET projects",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/projects?per_page=15"
      }
    },
    {
      "name": "POST projects",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Qasioun\",\n  \"status\": \"active\",\n  \"zones\": [\n    { \"name\": \"Zone A\", \"status\": \"active\" }\n  ]\n}"
        },
        "url": "{{baseUrl}}/api/v1/projects"
      }
    },
    {
      "name": "GET projects/{id}",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/projects/{{projectId}}"
      }
    },
    {
      "name": "PUT projects/{id}",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Qasioun\",\n  \"status\": \"active\",\n  \"zones\": [\n    { \"id\": 1, \"name\": \"Zone A\", \"status\": \"active\" }\n  ]\n}"
        },
        "url": "{{baseUrl}}/api/v1/projects/{{projectId}}"
      }
    },
    {
      "name": "PATCH projects/{id}",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Qasioun\",\n  \"status\": \"inactive\",\n  \"zones\": [\n    { \"id\": 1, \"name\": \"Zone A\", \"status\": \"active\" }\n  ]\n}"
        },
        "url": "{{baseUrl}}/api/v1/projects/{{projectId}}"
      }
    },
    {
      "name": "DELETE projects/{id}",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/projects/{{projectId}}"
      }
    },
    {
      "name": "POST projects/quick-store",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Quick project\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/projects/quick-store"
      }
    },
    {
      "name": "POST zones/quick-store",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"project_id\": 1,\n  \"name\": \"Quick zone\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/zones/quick-store"
      }
    },
    {
      "name": "Helpers",
      "item": [
        {
          "name": "projects",
          "item": [
            {
              "name": "q",
              "request": {
                "method": "GET",
                "header": [{ "key": "Accept", "value": "application/json" }],
                "url": "{{baseUrl}}/api/v1/projects?q=Qasioun"
              }
            },
            {
              "name": "status",
              "request": {
                "method": "GET",
                "header": [{ "key": "Accept", "value": "application/json" }],
                "url": "{{baseUrl}}/api/v1/projects?status=active"
              }
            },
            {
              "name": "per page",
              "request": {
                "method": "GET",
                "header": [{ "key": "Accept", "value": "application/json" }],
                "url": "{{baseUrl}}/api/v1/projects?per_page=15"
              }
            }
          ]
        }
      ]
    }
  ]
}
